+void BrowserView::OnZenModeVerticalTabRailPrefChanged() {
+  if (!zen_mode_enabled_) {
+    return;
+  }
+
+  // Turning the rail off returns the floating VTS to the slide-in behaviour,
+  // so re-evaluate the reveal from where the cursor currently is. Turning it
+  // on collapses the strip down to the rail.
+  MaybeExpandVerticalTabStripForZenMode();
+  UpdateZenModeRevealFromCursor();
