+bool BrowserView::IsZenModeVerticalTabRailEnabled() const {
+  if (!zen_mode_enabled_ || !ShouldDrawVerticalTabStrip() ||
+      IsZenModeSideChromePinned() ||
+      !browser_->profile()->GetPrefs()->GetBoolean(
+          prefs::kHeliumZenModeVerticalTabRail)) {
+    return false;
+  }
+  // The rail is what a *collapsed* strip looks like in zen mode; it never
+  // drives the collapse state itself. Expanding the strip while zen mode is on
+  // therefore returns it to the normal floating slide behaviour, which keeps
+  // the collapse toggle working and keeps this out of the persisted pref.
+  const auto* controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+  return controller && controller->IsCollapsed();
+}
