+void BrowserView::OnZenModeVerticalTabRailPrefChanged() {
+  if (!zen_mode_enabled_) {
+    return;
+  }
+
+  // The rail renders the collapsed strip, so turning the setting on collapses
+  // the strip to give the user what they just asked for. This is an explicit,
+  // user-initiated change and is left persisted; zen mode transitions never
+  // touch the collapse state on the rail's behalf. Turning the setting off
+  // returns the floating strip to the slide-in behaviour, so re-evaluate the
+  // reveal from where the cursor currently is.
+  auto* const controller = tabs::VerticalTabStripStateController::From(browser_);
+  const bool rail_pref_enabled = browser_->profile()->GetPrefs()->GetBoolean(
+      prefs::kHeliumZenModeVerticalTabRail);
+  if (rail_pref_enabled && controller && ShouldDrawVerticalTabStrip() &&
+      !IsZenModeSideChromePinned() && !controller->IsCollapsed()) {
+    controller->RequestCollapse(true);
+  }
+
+  MaybeExpandVerticalTabStripForZenMode();
+  UpdateZenModeRevealFromCursor();
+
+  if (vertical_tab_strip_region_view_) {
+    vertical_tab_strip_region_view_->UpdateInteriorMargin();
+  }
+
+  if (multi_contents_view_) {
+    multi_contents_view_->MaybeUpdateContentsBorderAndOverlay();
+  }
+  InvalidateLayout();
+}
